# ===== Runtime =====
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT,LTC/USDT,XRP/USDT,SOL/USDT,BNB/USDT,ADA/USDT,UNI/USDT,ETC/USDT
TIMEFRAME=1m
PAPER_TRADING=true
BASE_CURRENCY=USDT
MAX_NOTIONAL_PER_TRADE=100
DAILY_LOSS_LIMIT_PCT=2
RISK_TARGET_ATR_PCT=0.5

# ===== Gmail Alerts (Bot + Alertmanager) =====
GMAIL_FROM=dayashimoga098@gmail.com
GMAIL_TO=dayashimoga098@gmail.com

# ===== Prometheus/Grafana =====
METRICS_PORT=9101
GF_METRICS_ENABLED=true

# ===== Logging =====
LOG_LEVEL=INFO